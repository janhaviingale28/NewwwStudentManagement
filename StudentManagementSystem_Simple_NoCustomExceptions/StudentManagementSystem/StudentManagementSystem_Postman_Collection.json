{
  "info": {
    "name": "Student Management System - CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "departmentId",
      "value": "1"
    },
    {
      "key": "studentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Departments",
      "item": [
        {
          "name": "List departments - use actual IDs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            }
          }
        },
        {
          "name": "Get department",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "{{departmentId}}"
              ]
            }
          }
        },
        {
          "name": "Create department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Civil Engineering\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update department",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "{{departmentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Information Technology Updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete department - only if unused",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "{{departmentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            }
          }
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            }
          }
        },
        {
          "name": "Create student with profile and department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Janhavi Ingale\",\n  \"email\": \"janhavi.ingale@example.com\",\n  \"course\": \"Java Full Stack\",\n  \"profile\": {\n    \"address\": \"Ahmedabad, Gujarat\",\n    \"phone\": \"9876543210\"\n  },\n  \"department\": {\n    \"id\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update student + profile + department",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Janhavi Ingale\",\n  \"email\": \"janhavi.ingale@example.com\",\n  \"course\": \"Spring Boot\",\n  \"profile\": {\n    \"address\": \"Ahmedabad, Gujarat\",\n    \"phone\": \"9876543210\"\n  },\n  \"department\": {\n    \"id\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete student",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}